+
 void register_netfn_storage_write_fru() __attribute__((constructor));
 
 sd_bus* ipmid_get_sd_bus_connection(void);
 
 using namespace phosphor::logging;
 
+
+
+int writeToEEPROM(const char* filename, uint8_t i2cBus, uint8_t i2cAddr) {
+    uint8_t dataBuffer[32]; // Data buffer (max size for EEPROM page write)
+    size_t bytesRead;
+
+    // Construct the sysfs path to the EEPROM
+    char sysfsPath[50];
+    std::sprintf(sysfsPath, "/sys/class/i2c-dev/i2c-1/device/%d-00%02x/eeprom", i2cBus, i2cAddr);
+
+    // Open the sysfs EEPROM file for writing
+    int eepromFd = open(sysfsPath, O_WRONLY);
+    if (eepromFd < 0) {
+        perror("Failed to open EEPROM sysfs file");
+        return -1;
+    }
+
+    // Open the input file
+    FILE* fruFile = std::fopen(filename, "rb");
+    if (!fruFile) {
+        perror("Failed to open file");
+        close(eepromFd);
+        return -1;
+    }
+
+    uint16_t address = 0; // Starting EEPROM address
+    while ((bytesRead = std::fread(dataBuffer, 1, sizeof(dataBuffer), fruFile)) > 0) {
+        // Seek to the desired EEPROM address
+        if (lseek(eepromFd, address, SEEK_SET) < 0) {
+            perror("Failed to seek in EEPROM sysfs file");
+            close(eepromFd);
+            std::fclose(fruFile);
+            return -1;
+        }
+
+        // Write data to EEPROM
+        if (write(eepromFd, dataBuffer, bytesRead) != (ssize_t)bytesRead) {
+            perror("Failed to write to EEPROM");
+            close(eepromFd);
+            std::fclose(fruFile);
+            return -1;
+        }
+
+        // Increment the address for the next block
+        address += bytesRead;
+
+        // Delay to allow EEPROM to complete the write operation
+        usleep(5000); // 5ms delay (adjust as per EEPROM specs)
+    }
+
+    if (std::ferror(fruFile)) {
+        perror("Error reading file");
+        close(eepromFd);
+        std::fclose(fruFile);
+        return -1;
+    }
+
+    // Clean up resources
+    close(eepromFd);
+    std::fclose(fruFile);
+
+    return 0;
+}
+
