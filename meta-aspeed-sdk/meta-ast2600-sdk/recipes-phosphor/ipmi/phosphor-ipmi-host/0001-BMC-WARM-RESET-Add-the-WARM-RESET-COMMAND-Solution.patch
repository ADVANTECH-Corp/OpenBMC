From 454228229e85167ea0fb36c5e6ab73eaef6bed60 Mon Sep 17 00:00:00 2001
From: "jiun.wang" <jiun.wang@advantech.com.tw>
Date: Tue, 10 Jun 2025 14:38:57 +0800
Subject: [PATCH] [BMC WARM RESET] Add the WARM RESET COMMAND Solution

---
 globalhandler.cpp | 4 ++++
 globalhandler.hpp | 1 +
 ipmiwhitelist.cpp | 5 +++++
 3 files changed, 10 insertions(+)
 create mode 100644 ipmiwhitelist.cpp

diff --git a/globalhandler.cpp b/globalhandler.cpp
index 992bdd8..0e0beae 100644
--- a/globalhandler.cpp
+++ b/globalhandler.cpp
@@ -59,5 +59,9 @@ void register_netfn_global_functions()
     ipmi::registerHandler(ipmi::prioOpenBmcBase, ipmi::netFnApp,
                           ipmi::app::cmdColdReset, ipmi::Privilege::Admin,
                           ipmiGlobalReset);
+    // Warm Reset
+    ipmi::registerHandler(ipmi::prioOpenBmcBase, ipmi::netFnApp,
+                          ipmi::app::cmdWarmReset, ipmi::Privilege::Admin,
+                          ipmiGlobalReset);
     return;
 }
diff --git a/globalhandler.hpp b/globalhandler.hpp
index 078b170..23d3b3e 100644
--- a/globalhandler.hpp
+++ b/globalhandler.hpp
@@ -6,4 +6,5 @@
 enum ipmi_global_control_cmds : uint8_t
 {
     IPMI_CMD_COLD_RESET = 0x02,
+    IPMI_CMD_WARM_RESET = 0x03,
 };
diff --git a/ipmiwhitelist.cpp b/ipmiwhitelist.cpp
new file mode 100644
index 0000000..3a93fa6
--- /dev/null
+++ b/ipmiwhitelist.cpp
@@ -0,0 +1,5 @@
+#include <ipmiallowlist.hpp>
+
+const std::vector<netfncmd_pair> whitelist = {
+
+};
