diff --git a/board/aspeed/evb_ast2600/evb_ast2600.c b/board/aspeed/evb_ast2600/evb_ast2600.c
index 72ecb18c15..aebf13abc5 100644
--- a/board/aspeed/evb_ast2600/evb_ast2600.c
+++ b/board/aspeed/evb_ast2600/evb_ast2600.c
@@ -5,6 +5,7 @@
 #include <common.h>
 #include <asm/io.h>
 
+#define MMC_BASE    0x1e6e0000
 #define SCU_BASE	0x1e6e2000
 #define ESPI_BASE	0x1e6ee000
 #define LPC_BASE	0x1e789000
@@ -30,6 +31,24 @@
 /* HICRB Bits */
 #define HICRB_EN80HSGIO (1 << 13)	/* Enable 80hSGIO */
 
+#define SCU_04			0x04		/* MCR04 */
+#define SCU_500			0x500		/* Hardware Strap1 Register */
+#define SCU_510			0x510		/* Hardware Strap2 Register */
+
+/* MCR04 Register */
+#define SELECT_VGA_MEM_64MB_SIZE (0x3 << 2)
+#define SELECT_VGA_MEM_32MB_SIZE (0x2 << 2)
+#define SELECT_VGA_MEM_16MB_SIZE (0x1 << 2)
+#define SELECT_VGA_MEM_8MB_SIZE  (0x0 << 2)
+
+/* Hardware Strap1 Register */
+#define VGA_MEM_64MB (0x3 << 13)
+#define VGA_MEM_32MB (0x2 << 13)
+#define VGA_MEM_16MB (0x1 << 13)
+#define VGA_MEM_8MB (0x0 << 13)
+
+#define Dedicated_VGA_BIOS_ROM (1 << 5)
+
 static void __maybe_unused port80h_snoop_init(void)
 {
 	u32 value;
@@ -129,5 +148,20 @@ int board_early_init_f(void)
 	sgpio_init();
 #endif
 	espi_init();
+	
+	// Select VGA MEM SIZE 64MB
+	writel(0xfc600309, 0x1e6e0000); // Un-lock protect
+	writel(readl(MMC_BASE | SCU_04) | SELECT_VGA_MEM_64MB_SIZE,
+			MMC_BASE | SCU_04);
+    writel(0x0, 0x1e6e0000);   // lock protect
+
+	// Set VGA MEM 64MB
+	writel(readl(SCU_BASE | SCU_500) | VGA_MEM_64MB,
+			SCU_BASE | SCU_500);
+
+	// Set Dedicated_VGA_BIOS_ROM
+	writel(readl(SCU_BASE | SCU_500) | Dedicated_VGA_BIOS_ROM,
+			SCU_BASE | SCU_500);			
+			
 	return 0;
 }
