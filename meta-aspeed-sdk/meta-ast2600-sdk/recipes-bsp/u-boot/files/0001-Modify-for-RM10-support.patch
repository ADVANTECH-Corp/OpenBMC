-	phy_write(phydev, MDIO_DEVAD_NONE, 0x10, 0x617f);
+	// phy_write(phydev, MDIO_DEVAD_NONE, 0x10, 0x617f);
+	phy_write(phydev, MDIO_DEVAD_NONE, 0x10, 0x031B); // phy_write(phydev, MDIO_DEVAD_NONE, 0x10, 0xEF60);
+	phy_write(phydev, MDIO_DEVAD_NONE, 0x11, 0x6001);
 	phy_write(phydev, MDIO_DEVAD_NONE,
 		  MIIM_RTL8211F_PAGE_SELECT, 0x0);
 
