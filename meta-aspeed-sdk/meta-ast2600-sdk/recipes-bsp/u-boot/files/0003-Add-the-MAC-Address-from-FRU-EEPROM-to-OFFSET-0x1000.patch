From 6c4c2d228d2bd2aa55cbed57176a77944eabb2c6 Mon Sep 17 00:00:00 2001
From: Jiun Wang <jiun.wang@advantech.com.tw>
Date: Wed, 20 Aug 2025 12:56:11 +0800
Subject: [PATCH] Add the MAC Address from FRU EEPROM to OFFSET 0x1000 to get

---
 arch/arm/dts/ast2600-evb.dts           |  6 +++
 board/aspeed/evb_ast2600/evb_ast2600.c | 63 ++++++++++++++++++++++++++
 common/board_r.c                       |  3 ++
 include/common.h                       |  6 +++
 include/configs/evb_ast2600.h          |  3 ++
 5 files changed, 81 insertions(+)

diff --git a/arch/arm/dts/ast2600-evb.dts b/arch/arm/dts/ast2600-evb.dts
index 35b78cfa83..f626173499 100644
--- a/arch/arm/dts/ast2600-evb.dts
+++ b/arch/arm/dts/ast2600-evb.dts
@@ -120,6 +120,12 @@
 	};
 };
 
+&i2c1 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_i2c2_default>;
+};
+
 &i2c4 {
 	status = "okay";
 
diff --git a/board/aspeed/evb_ast2600/evb_ast2600.c b/board/aspeed/evb_ast2600/evb_ast2600.c
index 663c870301..9996f73ced 100644
--- a/board/aspeed/evb_ast2600/evb_ast2600.c
+++ b/board/aspeed/evb_ast2600/evb_ast2600.c
@@ -4,6 +4,12 @@
  */
 #include <common.h>
 #include <asm/io.h>
+#include <environment.h>
+#include <i2c.h>
+#include <dm.h>
+#include <i2c.h>
+#include <linux/types.h>
+#include <linux/errno.h>
 
 #define MMC_BASE    0x1e6e0000
 #define SCU_BASE	0x1e6e2000
@@ -193,3 +199,60 @@ int board_early_init_f(void)
 			
 	return 0;
 }
+
+#if Advantech_FRU_EEPROM_ENABLE
+#define CONFIG_FRU_I2C_EEPROM_ADDR 		0x56
+#define CONFIG_FRU_I2C_EEPROM_ADDR_LEN 	2
+#define CONFIG_FRU_I2C_OFFSET			0x1000
+int advantech_misc_init_r(void)
+{
+	uint8_t enetaddr[10];
+	static unsigned char mac_str[20];
+	unsigned int bus;
+	int rc;
+
+	/* Read MAC address. */
+	bus = i2c_get_bus_num();
+
+    i2c_set_bus_num(1); // selects I2C bus 1
+
+	rc = i2c_read(CONFIG_FRU_I2C_EEPROM_ADDR, CONFIG_FRU_I2C_OFFSET, CONFIG_FRU_I2C_EEPROM_ADDR_LEN, &enetaddr[0], 6);
+	if (rc) {
+        printf("i2c_read failed, rc=%d\n", rc);
+        return rc;  // If I2C read fails, return the error code
+    }
+
+	sprintf(mac_str, "%02x:%02x:%02x:%02x:%02x:%02x",
+				enetaddr[0], enetaddr[1], enetaddr[2], enetaddr[3], enetaddr[4],
+				enetaddr[5]);
+
+   	if (env_get("ethaddr"))
+   	{
+		printf("end..ethaddr.\n");
+		return 0;
+   	}
+
+#if 0
+    // For debug
+    printf("%s: enetaddr[0]=0x%02x, enetaddr[1]=0x%02x, enetaddr[2]=0x%02x, enetaddr[3]=0x%02x, enetaddr[4]=0x%02x, enetaddr[5]=0x%02x, rc=0x%02x\n",
+	       __func__, enetaddr[0], enetaddr[1], enetaddr[2], enetaddr[3], enetaddr[4], enetaddr[5], rc);
+#endif
+
+    rc = env_set("ethaddr", mac_str);
+	if (rc) {
+    	printf("Failed to set ethaddr\n");
+    	return rc;  // If env_set fails, return the error code
+	}
+    
+	// Save the environment
+	rc = env_save();
+	if (rc) {
+    	printf("Failed to save environment\n");
+    	return rc;  // If env_save fails, return the error code
+	}
+
+	i2c_set_bus_num(bus);
+
+	return 0;
+}
+#endif
diff --git a/common/board_r.c b/common/board_r.c
index 429b9a2833..28f5040d69 100644
--- a/common/board_r.c
+++ b/common/board_r.c
@@ -767,6 +767,9 @@ static init_fnc_t init_sequence_r[] = {
 #ifdef CONFIG_ARCH_MISC_INIT
 	arch_misc_init,		/* miscellaneous arch-dependent init */
 #endif
+#if Advantech_FRU_EEPROM_ENABLE
+	advantech_misc_init_r,
+#endif
 #ifdef CONFIG_MISC_INIT_R
 	misc_init_r,		/* miscellaneous platform-dependent init */
 #endif
diff --git a/include/common.h b/include/common.h
index 2c21dee850..020fd11bc2 100644
--- a/include/common.h
+++ b/include/common.h
@@ -295,6 +295,12 @@ int board_late_init (void);
 int board_postclk_init (void); /* after clocks/timebase, before env/serial */
 int board_early_init_r (void);
 
+#define Advantech_FRU_EEPROM_ENABLE     1
+
+#if Advantech_FRU_EEPROM_ENABLE
+int advantech_misc_init_r(void);
+#endif
+
 #if defined(CONFIG_SYS_DRAM_TEST)
 int testdram(void);
 #endif /* CONFIG_SYS_DRAM_TEST */
diff --git a/include/configs/evb_ast2600.h b/include/configs/evb_ast2600.h
index 3a85488b6f..4f6c0e6786 100644
--- a/include/configs/evb_ast2600.h
+++ b/include/configs/evb_ast2600.h
@@ -52,3 +52,6 @@
 	""
 
 #endif	/* __CONFIG_H */
+
+#define CONFIG_ENV_OVERWRITE	1
+
